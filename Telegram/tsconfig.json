{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "rootDir": "src",
    "outDir": "dist",

    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,

    "sourceMap": true,

    "verbatimModuleSyntax": true,
    "moduleDetection": "force",

    "allowImportingTsExtensions": true,
    "noEmit": true
  },

  "include": ["src/**/*"],
  "exclude": ["dist", "node_modules"]
}